# ==========================
# Environment Configuration
# Food Delivery Backend
# ==========================

# --- App ---
NODE_ENV=development
PORT=5000
APP_NAME="Food Delivery API"
APP_VERSION="1.0.0"
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# --- Supabase ---
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# --- JWT Auth ---
JWT_SECRET=[GENERATE-STRONG-SECRET-64-CHARS]
JWT_REFRESH_SECRET=[GENERATE-STRONG-REFRESH-SECRET-64-CHARS]
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=[YOUR-CLOUD-NAME]
CLOUDINARY_API_KEY=[YOUR-API-KEY]
CLOUDINARY_API_SECRET=[YOUR-API-SECRET]
CLOUDINARY_FOLDER=food-delivery

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=[YOUR-EMAIL]
SMTP_PASS=[YOUR-APP-PASSWORD]
EMAIL_FROM="Food Delivery <noreply@fooddelivery.com>"

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# --- OTP ---
OTP_EXPIRES_IN=300
OTP_LENGTH=6



# --- Google Maps (Optional) ---
GOOGLE_MAPS_API_KEY=[YOUR-GOOGLE-MAPS-KEY]

# --- Logging ---
LOG_LEVEL=debug
LOG_DIR=logs
