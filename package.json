{
    "name": "food-delivery-backend",
    "version": "1.0.0",
    "description": "Scalable food delivery backend REST API built with Node.js, Express, PostgreSQL (Supabase), Prisma, Redis, and Socket.io",
    "main": "src/server.js",
    "type": "commonjs",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "dev:debug": "nodemon --inspect src/server.js",
        "lint": "eslint . --ext .js",
        "lint:fix": "eslint . --ext .js --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:migrate:prod": "prisma migrate deploy",
        "db:push": "prisma db push",
        "db:seed": "node prisma/seed.js",
        "db:studio": "prisma studio",
        "db:reset": "prisma migrate reset",
        "test": "jest --runInBand",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "dependencies": {
        "@prisma/client": "^5.10.2",
        "bcryptjs": "^2.4.3",
        "bullmq": "^5.67.1",
        "cloudinary": "^1.41.3",
        "compression": "^1.7.4",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "csv-parse": "^6.2.0",
        "dotenv": "^17.3.1",
        "express": "^4.18.3",
        "express-rate-limit": "^7.2.0",
        "express-validator": "^7.0.1",
        "helmet": "^7.1.0",
        "ioredis": "^5.3.2",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "multer-storage-cloudinary": "^4.0.0",
        "nodemailer": "^6.9.12",
        "socket.io": "^4.7.4",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^9.0.1",
        "winston": "^3.13.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@faker-js/faker": "^8.4.1",
        "eslint": "^8.57.0",
        "jest": "^29.7.0",
        "nodemon": "^3.1.0",
        "prettier": "^3.2.5",
        "prisma": "^5.10.2",
        "supertest": "^6.3.4"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "keywords": [
        "food-delivery",
        "nodejs",
        "express",
        "postgresql",
        "prisma",
        "redis",
        "socket.io"
    ],
    "author": "",
    "license": "MIT",
    "prisma": {
        "seed": "node prisma/seed.js"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/__tests__/**/*.test.js"
        ],
        "coverageDirectory": "coverage",
        "collectCoverageFrom": [
            "src/**/*.js",
            "!src/server.js"
        ]
    }
}
